<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <Color x:Key="PrimaryBackgroundColor">#243B53</Color>
  <Color x:Key="PrimaryForgroundColor">#F4F6F8</Color>
  <Color x:Key="PrimaryAccentColor">#3CBFA5</Color>
  <Color x:Key="PrimaryBorderBackgroundColor">#020A3B</Color>
  <Color x:Key="PrimaryBorderColor">#AEEFFA</Color>
  <Color x:Key="PrimaryWarningColor">#FF2E2E</Color>
  <Color x:Key="PrimaryButtonColor">#486581</Color>
  <Color x:Key="SecondaryBackgroundColor">#3C556D</Color>
  <Color x:Key="SecondaryBorderColor">#283F4D</Color>
</ResourceDictionary>
