<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <SolidColorBrush x:Key="ForgroundColor" Color="{DynamicResource PrimaryForgroundColor}" />
  <SolidColorBrush x:Key="BackgroundColor" Color="{DynamicResource PrimaryBackgroundColor}" />
  <SolidColorBrush x:Key="AccentColor" Color="{DynamicResource PrimaryAccentColor}" />
  <SolidColorBrush x:Key="BorderBackgroundColor" Color="{DynamicResource PrimaryBorderBackgroundColor}" />
  <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource PrimaryBorderColor}" />
  <SolidColorBrush x:Key="WarningColor" Color="{DynamicResource PrimaryWarningColor}" />
  <SolidColorBrush x:Key="ButtonColor" Color="{DynamicResource PrimaryButtonColor}" />
  <SolidColorBrush x:Key="SecBackgroundColor" Color="{DynamicResource SecondaryBackgroundColor}" />
  <SolidColorBrush x:Key="SecBorderColor" Color="{DynamicResource SecondaryBorderColor}" />
  <SolidColorBrush x:Key="WhiteColor" Color="{DynamicResource PrimaryWhiteColor}" />
  <SolidColorBrush x:Key="TextBoxForgroundColor" Color="{DynamicResource PrimaryTextBoxForgroundColor}" />
  <SolidColorBrush x:Key="TextBoxBorderColor" Color="{DynamicResource PrimaryTextBoxBorderColor}" />

</ResourceDictionary>
