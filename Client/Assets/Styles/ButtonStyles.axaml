<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource BackgroundColor}">
      <!-- Add Controls for Previewer Here -->
       <StackPanel>
          <Button Classes="menu">Studenter</Button>
         <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="warning">Nej</Button>
          <Button Classes="form">Ja</Button>
         </StackPanel>
         <Button Classes="add">Lägg till student</Button>


       </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
   <Style Selector="Button">

   </Style>

   <Style Selector="Button.menu">
    <Setter Property="Foreground" Value="{DynamicResource ForgroundColor}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="15 10" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Background" Value="{DynamicResource ButtonColor}" />
   </Style>

   <Style Selector="Button.warning">
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
    <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Padding" Value="30 20" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
   </Style>

   <Style Selector="Button.form">
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
    <Setter Property="Foreground" Value="{DynamicResource ForgroundColor}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Padding" Value="30 20" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
   </Style>

   <Style Selector="Button.add">
    <Setter Property="Background" Value="{DynamicResource ButtonColor}" />
    <Setter Property="Foreground" Value="{DynamicResource ForgroundColor}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="20 10" />

   </Style>
</Styles>


