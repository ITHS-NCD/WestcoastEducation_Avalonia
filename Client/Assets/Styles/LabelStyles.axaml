<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource BackgroundColor}">
      <!-- Add Controls for Previewer Here -->
       <StackPanel>
        <Label Content="Test text" />
        <Label Classes="pageTitle" Content="Westcoast Education" />
        <Label Classes="form" Content="Förnamn"/>
       </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
   <Style Selector="Label">
      <Setter Property="Foreground" Value="{DynamicResource ForgroundColor}" />
      <Setter Property="FontSize" Value="20" />
   </Style>

   <Style Selector="Label.iconMenu">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Padding" Value="0 4 0 0" />
   </Style>

   <Style Selector="Label.pageTitle">
    <Setter Property="FontSize" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForgroundColor}" />
    <Setter Property="Padding" Value="30" />
   </Style>

   <Style Selector="Label.form">
      <Setter Property="FontSize" Value="28" />
   </Style>

   <Style Selector="Label.popup">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="Padding" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Center" />
   </Style>
</Styles>
