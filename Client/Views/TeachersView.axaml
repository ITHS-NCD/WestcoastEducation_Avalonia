<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="450"
             x:Class="Client.Views.TeachersView"
             x:DataType="vm:TeachersViewModel"
             Background="{DynamicResource BackgroundColor}">

             <Design.DataContext>
              <vm:TeachersViewModel/>
             </Design.DataContext>
            
             <StackPanel>
              <Label Classes="pageTitle" Content="{Binding PageTitle}" />

              <Button Classes="add" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddTeacher}">
                <StackPanel Orientation="Horizontal">
                  <Label FontFamily="{DynamicResource IconFont}" Content="&#xE3D4;" Margin="0 3 0 0" />
                  <Label Content="Lägg till lärare" />
                </StackPanel>
              </Button>

              <Border Classes="topBar">
                <Grid ColumnDefinitions="200,200,350,*,60,60">
                  <Label Classes="form" Content="Förnamn" />
                  <Label Classes="form" Grid.Column="1" Content="Efternamn" />
                  <Label Classes="form" Grid.Column="2" Content="E-post" />
                  <Label Classes="form" Grid.Column="3" Content="Telefon nummer" />
                </Grid>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Teachers}" Margin="20 0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="10 0">
                        <Grid ColumnDefinitions="200,200,350,*,240,60,60">
                          <Label Content="{Binding FirstName}" />
                          <Label Grid.Column="1" Content="{Binding LastName}" />
                          <Label Grid.Column="2" Content="{Binding Email}" />
                          <Label Grid.Column="3" Content="{Binding PhoneNumber}" />
                          <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToKnowledge}" CommandParameter="{Binding Id}" Grid.Column="4" Content="Visa kunskapsområden" Padding="5" Margin="5 2" />
                          <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToEditTeacher}" CommandParameter="{Binding Id}" Grid.Column="5" FontFamily="{DynamicResource IconFont}" Content="&#xEBC6;" FontSize="16" />
                          <Button Command="{Binding $parent[UserControl].DataContext.Delete}" CommandParameter="{Binding Id}" Grid.Column="6" FontFamily="{DynamicResource IconFont}" Content="&#xE4A6;" FontSize="16" Foreground="{DynamicResource WarningColor}" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
                <Border Classes="popup" >
                  <StackPanel>
                      <Label Classes="popup" Content="Är du säker du vill ta bort läraren?" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                      <Button Classes="form" Command="{Binding CancelCommand}">Nej</Button>
                      <Button Classes="warning" Command="{Binding ConfirmCommand}">Ja</Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Popup>

            </StackPanel>
</UserControl>
