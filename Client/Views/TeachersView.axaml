<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.TeachersView"
             x:DataType="vm:TeachersViewModel"
             Background="{DynamicResource BackgroundColor}">

             <Design.DataContext>
              <vm:TeachersViewModel/>
             </Design.DataContext>
            
             <StackPanel>
              <Label Classes="pageTitle" Content="{Binding PageTitle}" />

              <Button FontSize="16" Margin="20 10">
                <StackPanel Orientation="Horizontal">
                  <Label FontFamily="{DynamicResource IconFont}" Content="&#xE3D4;" Margin="0 3 0 0" />
                  <Label Content="Lägg till kurs" />
                </StackPanel>
              </Button>

              <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="5 20 5 10">
                <Grid ColumnDefinitions="200,200,200,*,60,60">
                  <Label Content="Förnamn" />
                  <Label Grid.Column="1" Content="Efternamn" />
                  <Label Grid.Column="2" Content="E-post" />
                  <Label Grid.Column="3" Content="Telefon nummer" />
                </Grid>
              </Border>
              <ScrollViewer Height="1000">
                <ItemsControl ItemsSource="{Binding Teachers}" Margin="0 10 0 0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="200,200,200,*,60,60">
                        <Label Content="{Binding FirstName}" />
                        <Label Grid.Column="1" Content="{Binding LastName}" />
                        <Label Grid.Column="2" Content="{Binding Email}" />
                        <Label Grid.Column="3" Content="{Binding PhoneNumber}" />
                        <Button Grid.Column="5" FontFamily="{DynamicResource IconFont}" Content="&#xEBC6;" />
                        <Button Grid.Column="6" FontFamily="{DynamicResource IconFont}" Content="&#xE4A6;" />

                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

            </StackPanel>

</UserControl>
