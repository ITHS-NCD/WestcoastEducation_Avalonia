<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

             <Design.DataContext>
              <vm:CoursesViewModel/>
             </Design.DataContext>

            <StackPanel>
              <Label Content="{Binding PageTitle}" FontSize="24" />

              <Button FontSize="16">
                <StackPanel>
                  <Label FontFamily="{DynamicResource IconFont}" Content="&#xE3D4;" />
                  <Label Content="Lägg till kurs" />
                </StackPanel>
              </Button>

              <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="5 20 5 10">
                <Grid ColumnDefinitions="200,200,200,200,*,60,60">
                  <Label Content="Kurs titel" />
                  <Label Grid.Column="1" Content="Längd" />
                  <Label Grid.Column="2" Content="Start" />
                  <Label Grid.Column="3" Content="Slut" />
                  <Label Grid.Column="4" Content="I klassrum" />
                </Grid>
              </Border>
              <ScrollViewer Height="1000">
                <ItemsControl ItemsSource="{Binding Courses}" Margin="0 10 0 0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="200,200,200,200,*,60,60">
                        <Label Content="{Binding CourseTitle}" />
                        <Label Grid.Column="1" Content="{Binding Length}" />
                        <Label Grid.Column="2" Content="{Binding Start}" />
                        <Label Grid.Column="3" Content="{Binding End}" />
                        <Label Grid.Column="4" Content="{Binding ClassRoom}" />
                        <Button Grid.Column="5" FontFamily="{DynamicResource IconFont}" Content="&#xEBC6;" />
                        <Button Grid.Column="6" FontFamily="{DynamicResource IconFont}" Content="&#xE4A6;" />

                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>







            </StackPanel>

</UserControl>
