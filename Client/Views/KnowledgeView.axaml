<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.KnowledgeView"
             x:DataType="vm:KnowledgeViewModel">

             <Design.DataContext> <vm:KnowledgeViewModel/> </Design.DataContext>
            
             <StackPanel>
               <Label Classes="pageTitle" Content="{Binding PageTitle}" />

              <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddKnowledge}" CommandParameter="{Binding Id}" FontSize="16" Margin="20 10" >
                <StackPanel Orientation="Horizontal">
                  <Label FontFamily="{DynamicResource IconFont}" Content="&#xE3D4;" Margin="0 3 0 0" />
                  <Label Content="Lägg till kunskapsområde" />
                </StackPanel>
              </Button>
              <Border BorderBrush="White" BorderThickness="0 0 0 1" Margin="40 10" Padding="5 20 5 10" HorizontalAlignment="Left">
                  <Label Content="Kunskapsområden" />
              </Border>
              <ScrollViewer Margin="10 0">
                <ItemsControl ItemsSource="{Binding Knowledge}" Margin="10 0 0 10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="list">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal"  Margin="10 0">
                            <Label Content="•" FontSize="16" />
                            <Label Content="{Binding}" FontSize="14" Margin="10,2"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="5" Grid.Column="1" HorizontalAlignment="Right">
                            <Button Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding}" FontFamily="{DynamicResource IconFont}" Content="&#xE4A6;"></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Button Classes="form" HorizontalAlignment="Center" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToTeachers}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Label FontFamily="{DynamicResource IconFont}" Content="&#xE08A;" />
                        <Label Content="Tillbaka" />
                    </StackPanel>
                </Button>


              <Popup IsOpen="{Binding ShowWarning}" Placement="Center">
                <Border Classes="popup" >
                  <StackPanel>
                      <Label Classes="popup" Content="Är du säker du vill ta bort kunskapsområdet?" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                      <Button Classes="form" Command="{Binding CancelCommand}">Nej</Button>
                      <Button Classes="form" Command="{Binding ConfirmWarningCommand}">Ja</Button>

                    </StackPanel>
                  </StackPanel>
                </Border>
              </Popup>

              <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
                <Border Classes="popup">
                  <StackPanel>
                      <Label Classes="popup" Content="Finns inga kunskapsområden" />
                    <Button Command="{Binding CancelCommand}" FontFamily="{DynamicResource IconFont}" Content="&#xEBA6;" FontSize="20" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Popup>

             </StackPanel>
            
             

</UserControl>
